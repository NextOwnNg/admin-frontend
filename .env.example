# Copy to .env.local and adjust. Everything prefixed VITE_ ships in the browser bundle,
# so never put secrets here. Deployments set these in the Vercel project's Environment Variables.

# Where the admin API lives. Defaults to same-origin /api (also where the mock API answers).
VITE_ADMIN_API_BASE_URL=/api
# true = serve the in-browser mock admin API with fictional staff and records (no backend needed).
# Previews run on the mock API until the backend exists.
VITE_USE_MOCK_API=false
# local | preview | staging | production. Every value except production shows the environment ribbon.
VITE_ENV_NAME=production
